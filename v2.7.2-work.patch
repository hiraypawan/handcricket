+/* ==========================================================================
+   v2.6.1 — layout hardening & consistency pass
+   (arena composition, hand overlap, toss compactness, dock fixes)
+   ========================================================================== */
+
+/* ---- hands: bottom band, hard-capped so they can never brush the upper
+   band (centre card / timer) no matter how short the arena is */
+.arena{align-items:flex-end;justify-content:space-between}
+.player-side{flex:1 1 0;min-width:0;max-width:52%;height:100%;
+  justify-content:flex-end;padding-bottom:2px}
+.hand-wrap{width:min(100%,clamp(100px,21vh,172px));height:auto;aspect-ratio:4/5;
+  max-height:46%;min-height:0}
+.hand-wrap .arena-hand{width:100%;height:100%}
+.gesture-label{margin-top:3px}
+
+/* ---- centre card & pick timer live in the UPPER band (hands sit lower) */
+.center-card{top:24%;min-width:0;width:max-content;max-width:62%}
+.timer-wrap{top:36%}
+.countdown{top:36%}
+.flash{top:32%}
+
+/* ---- keep the top corners free of clutter on small screens */
+@media(max-width:420px){
+  .player-card{display:none}
+}
+
