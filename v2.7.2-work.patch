+               radial-gradient(900px 420px at 80% 110%,rgba(139,124,246,.14),transparent 60%),#0a1120;}
+  body.stands{background:linear-gradient(#b9d48b 0 46%,#e07a3f 46% 88%,#7ea35a 88%);}
+  header{padding:18px 20px 6px}
+  h1{margin:0 0 4px;font-size:20px;letter-spacing:.4px}
+  header p{margin:0;color:var(--soft);max-width:860px}
+  .bar{display:flex;flex-wrap:wrap;gap:14px;align-items:center;padding:14px 20px;
+    background:var(--glass);border:1px solid var(--line);border-radius:16px;margin:14px 20px}
+  .poses{display:flex;gap:8px}
+  .pbtn{display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;
+    width:56px;padding:6px 4px 4px;border-radius:14px;border:1px solid var(--line);
+    background:rgba(255,255,255,.06);color:var(--ink)}
+  .pbtn svg{width:34px;height:44px;display:block}
+  .pbtn b{font-size:12px}
+  .pbtn.sel{border-color:var(--teal);background:rgba(45,212,191,.16)}
+  label.ctl{display:flex;flex-direction:column;gap:4px;font-size:11px;color:var(--soft);letter-spacing:.6px}
+  input[type=range]{width:130px;accent-color:var(--teal)}
+  select,button.act{background:rgba(255,255,255,.08);color:var(--ink);border:1px solid var(--line);
+    border-radius:10px;padding:8px 12px;font:inherit}
+  button.act{cursor:pointer}
+  button.act:hover{background:rgba(255,255,255,.14)}
+  button.act.primary{border-color:var(--amber);background:rgba(251,191,36,.18);color:#fde68a;font-weight:700}
+  .stages{display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:0 20px 30px}
+  @media (max-width:820px){.stages{grid-template-columns:1fr}}
+  .stage{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:rgba(8,14,26,.55)}
+  body.stands .stage{background:rgba(20,40,20,.25)}
+  .stage h2{margin:0;padding:10px 14px;font-size:13px;letter-spacing:1px;color:var(--soft);
+    border-bottom:1px solid var(--line);display:flex;justify-content:space-between}
+  .stage h2 em{font-style:normal;color:var(--amber)}
+  .arena{display:flex;justify-content:space-between;align-items:flex-end;gap:8px;
+    padding:18px 22px 10px;min-height:280px}
+  .wrap{position:relative;display:flex;justify-content:center;align-items:flex-end}
+  .wrap svg{width:100%;height:100%;display:block}
+  /* v2.6 shake: both hands identical + in lockstep (that's the point) */
+  .wrap.shake-old{animation:hs .35s ease-in-out infinite}
+  @keyframes hs{0%,100%{transform:translateY(0) rotate(0)}25%{transform:translateY(-9px) rotate(-4deg)}75%{transform:translateY(-9px) rotate(4deg)}}
+  .wrap.pop-old{animation:rp .6s cubic-bezier(.3,1.6,.5,1)}
+  @keyframes rp{0%{transform:scale(.45);opacity:0}60%{transform:scale(1.12);opacity:1}100%{transform:scale(1);opacity:1}}
