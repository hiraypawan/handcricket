+  .wrap.shake-new{animation:hn .46s ease-in-out infinite;animation-delay:var(--d,0s)}
+  @keyframes hn{0%,100%{transform:translateY(0) rotate(0)}
+    30%{transform:translateY(calc(-11px * var(--amp,1))) rotate(calc(-6deg * var(--amp,1)))}
