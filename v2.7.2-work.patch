+<title>Hand Cricket — v2.7 hand preview playground</title>
+<style>
+  :root{
+    --ink:#eef4ff; --soft:rgba(238,244,255,.62); --glass:rgba(255,255,255,.09);
+    --line:rgba(255,255,255,.22); --amber:#fbbf24; --teal:#2dd4bf; --violet:#8b7cf6;
+  }
+  *{box-sizing:border-box}
+  body{margin:0;font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;color:var(--ink);
