+   ========================================================================== */
+.coin-container{width:clamp(96px,15vh,132px);height:clamp(96px,15vh,132px);margin:8px auto;position:relative;perspective:900px}
+.coin-container::after{content:'';position:absolute;bottom:-12px;left:10%;right:10%;height:14px;
+  background:radial-gradient(ellipse,rgba(0,0,0,.6) 0%,transparent 70%);border-radius:50%;filter:blur(5px);z-index:0}
+.coin{width:100%;height:100%;position:relative;transform-style:preserve-3d;transform:rotateY(0);z-index:1;will-change:transform}
+.coin.flipping{animation:coinFlip 2.3s cubic-bezier(.5,.05,.6,.4) forwards}
+.coin.landing{animation:coinBounce .55s cubic-bezier(.3,1.4,.4,1) forwards}
+@keyframes coinFlip{
+0%{transform:rotateY(0) translateY(30px) scale(.82)}
+10%{transform:rotateY(calc(var(--coin-total,2160deg)*.13)) translateY(-52px) scale(1.12)}
+26%{transform:rotateY(calc(var(--coin-total,2160deg)*.3)) translateY(-76px) scale(1.2)}
+44%{transform:rotateY(calc(var(--coin-total,2160deg)*.5)) translateY(-54px) scale(1.1)}
