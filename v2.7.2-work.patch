+  @keyframes th{0%{transform:translateY(6px) rotate(0) scale(.96)}
+    45%{transform:translateY(-16px) rotate(var(--tilt,-8deg)) scale(1.08)}
+    100%{transform:translateY(0) rotate(0) scale(1)}}
+  .cap{padding:0 14px 12px;color:var(--soft);font-size:12px}
+  .note{margin:0 20px 26px;color:var(--soft);font-size:12px}
+  code{background:rgba(255,255,255,.1);padding:1px 5px;border-radius:6px}
+</style>
+</head>
+<body>
+<header>
+  <h1>Hand Cricket — v2.7 hand preview playground</h1>
+  <p>Left: today's shipped renderer (v2.6, <code>public/js/04-hands.js</code> — static capsules swapped via
+     <code>innerHTML</code>). Right: the proposed v2.7 articulated renderer (one persistent SVG skeleton,
+     rAF joint tweens, staggered finger extension). Pick a pose or hit <b>REVEAL</b> to compare the motion.</p>
+</header>
+
+<div class="bar">
+  <div class="poses" id="poses"></div>
+  <label class="ctl">SIZE <input id="size" type="range" min="70" max="240" value="150"/></label>
+  <label class="ctl">TWEEN <input id="dur" type="range" min="80" max="600" value="240"/></label>
+  <label class="ctl">STAGGER <input id="stag" type="range" min="0" max="90" value="42"/></label>
+  <label class="ctl">SKIN
+    <select id="tone">
+      <option value="0">warm tan</option><option value="1">light</option>
+      <option value="2">medium brown</option><option value="3">deep brown</option>
+      <option value="4">darkest</option>
+    </select></label>
+  <label class="ctl"><input id="shake" type="checkbox" checked/> shake while waiting</label>
+  <label class="ctl"><input id="bg" type="checkbox"/> orange-stands bg</label>
+  <button class="act primary" id="reveal">REVEAL</button>
+  <button class="act" id="rally">auto rally</button>
+</div>
+
+<div class="stages">
+  <div class="stage">
+    <h2>v2.6 — SHIPPED <em>innerHTML swap + scale pop</em></h2>
+    <div class="arena">
+      <div class="wrap" id="oldP"></div>
+      <div class="wrap" id="oldO"></div>
+    </div>
+    <div class="cap">Both hands bob in lockstep (±4°, 0.35s). Gesture change = whole drawing replaced in one frame.</div>
+  </div>
+  <div class="stage">
+    <h2>v2.7 — PROPOSAL <em>articulated joints, staggered</em></h2>
+    <div class="arena">
+      <div class="wrap" id="newP" style="--d:0s;--amp:1;--tilt:-8deg"></div>
+      <div class="wrap" id="newO" style="--d:-.19s;--amp:.82;--tilt:8deg"></div>
+    </div>
+    <div class="cap">Shake desynced per hand; on reveal the fingers extend index→pinky with a wrist flick. Respects <code>prefers-reduced-motion</code>.</div>
+  </div>
+</div>
+<p class="note">Pose meanings: 0 fist (dot) · 1–4 fingers · 5 open palm (five) · 6 thumb-up (six).
+   Drag SIZE to 70px to check phone legibility.</p>
+
+<script src="old-hands-v26.js"></script>
+<script src="hands-v27.js"></script>
+<script>
+(function(){
+  var $ = function(id){ return document.getElementById(id); };
+  var pose = 1;
+  var oldP = $("oldP"), oldO = $("oldO"), newPW = $("newP"), newOW = $("newO");
+
+  // ---- mount v2.7 skeletons once ----
+  var ctlP = HandV27.mount(newPW, true);
+  var ctlO = HandV27.mount(newOW, false);
+
+  function sizeAll(){
+    var px = +$("size").value;
+    [oldP, oldO, newPW, newOW].forEach(function(w){
+      w.style.width = px + "px"; w.style.height = Math.round(px * 1.25) + "px";
+    });
+  }
+  function toneAll(){
+    var t = +$("tone").value;
+    ctlP = HandV27.mount(newPW, true, { tone: t });
+    ctlO = HandV27.mount(newOW, false, { tone: t });
+    setPose(pose, false);
+  }
+  function oldRender(v){
+    oldP.innerHTML = getHandSVG(v, true);
+    oldO.innerHTML = getHandSVG(v, false);
+  }
+  function shake(on){
+    var cls;
+    [oldP, oldO].forEach(function(w){ w.classList.toggle("shake-old", on); });
+    [newPW, newOW].forEach(function(w){ w.classList.toggle("shake-new", on); });
+  }
+  function setPose(v, animate){
+    pose = v;
+    document.querySelectorAll(".pbtn").forEach(function(b){
+      b.classList.toggle("sel", +b.dataset.v === v);
+    });
+    // OLD: teleport + pop (exactly what ships today)
+    oldRender(v);
+    [oldP, oldO].forEach(function(w){
+      w.classList.remove("pop-old"); void w.offsetWidth; w.classList.add("pop-old");
+    });
+    // NEW: joint tween with stagger + wrist flick
+    var o = { duration: +$("dur").value, stagger: +$("stag").value, animate: animate !== false };
+    ctlP.set(v, o); ctlO.set(v, o);
+    if (animate !== false) {
+      [newPW, newOW].forEach(function(w){
+        w.classList.remove("throw-new"); void w.offsetWidth; w.classList.add("throw-new");
+      });
+    }
+  }
+
+  // ---- pose buttons with mini-hand previews ----
+  var labels = ["DOT","1","2","3","4","FIVE","SIX"];
+  var bar = $("poses");
+  for (var v = 0; v <= 6; v++) {
+    var b = document.createElement("button");
+    b.className = "pbtn"; b.dataset.v = v;
+    b.innerHTML = HandV27.draw(v, true, { detail: "mini", tone: 0 }) + "<b>" + labels[v] + "</b>";
+    b.onclick = function(){ setPose(+this.dataset.v, true); };
+    bar.appendChild(b);
+  }
+
+  $("size").oninput = sizeAll;
+  $("tone").onchange = toneAll;
+  $("shake").onchange = function(){ shake(this.checked); };
+  $("bg").onchange = function(){ document.body.classList.toggle("stands", this.checked); };
+  $("reveal").onclick = function(){
+    shake(true);
+    setTimeout(function(){
+      shake($("shake").checked);
+      setPose(Math.floor(Math.random() * 7), true);
+    }, 420);
+  };
+  var rallyId = null;
+  $("rally").onclick = function(){
+    if (rallyId) { clearInterval(rallyId); rallyId = null; this.textContent = "auto rally"; return; }
+    this.textContent = "stop rally";
+    var self = this;
+    rallyId = setInterval(function(){ $("reveal").onclick(); }, 1500);
+  };
+
+  sizeAll(); toneAll(); shake(true); setPose(1, false);
+})();
+</script>
+</body>
+</html>
