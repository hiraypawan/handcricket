+.toss-call-title{font-size:15px;margin-top:0}
+.toss-call-sub{margin:2px 0 8px}
+.toss-call-btns,.toss-choice-btns{gap:10px}
+.toss-btn{padding:10px 6px;border-radius:16px}
+.toss-btn b{font-size:12.5px}
+.coin-mini{width:40px;height:40px;flex:0 0 40px;border-width:2px}
+.coin-mini svg{width:20px;height:20px}
+.toss-lines{min-height:46px;margin:2px 0 0}
+.toss-choice{padding:11px 6px;border-radius:16px}
+.toss-win-sub{margin-bottom:3px}
+#tossCallBox>*,#tossDecision>*{max-width:100%}
+
+/* ---- bottom dock: menu overlay must let taps reach it */
+#menuOverlay{pointer-events:none}
+#menuOverlay>*{pointer-events:auto}
+.tab-btn{min-width:0;flex:1}
+.tab-btn svg{width:20px;height:20px}
+
+/* ---- overlays: never clip content on tiny/landscape screens */
+@media(max-width:340px){
+  .overlay{padding-left:10px;padding-right:10px}
